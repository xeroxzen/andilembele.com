[Unit]
Description=andilembele.com Spotify now-playing endpoint
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/node /opt/now-playing/server.mjs
Environment=PORT=4180
# Root-owned, mode 600: SPOTIFY_CLIENT_ID, SPOTIFY_CLIENT_SECRET, SPOTIFY_REFRESH_TOKEN
EnvironmentFile=/etc/now-playing.env
DynamicUser=yes
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=128M

[Install]
WantedBy=multi-user.target
