# Copy to .env and fill in real values. `.env` is gitignored.

SITE_URL=https://andilembele.com

# Optional. Required to lock the local CMS (npm start). Must be 12+ characters.
# CMS_ADMIN_PASSWORD=

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=

# Comma-separated Google accounts allowed to use /admin in production.
CMS_ADMIN_EMAILS=
FIRESTORE_BACKUP_ACCOUNT=
