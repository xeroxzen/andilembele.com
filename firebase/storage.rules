rules_version = '2';
// Generated from CMS_ADMIN_EMAILS in .env. Do not edit this file by hand.
service firebase.storage {
 match /b/{bucket}/o {
  function admin() {
   return request.auth != null && request.auth.token.email_verified == true
    && request.auth.token.firebase.sign_in_provider == 'google.com'
    && request.auth.token.email.lower() in ["thabheloduve@gmail.com","andilembele020@gmail.com"];
  }
  match /posts/{name} {
   allow get, delete: if admin();
   allow create: if admin()
    && name.matches('[a-f0-9-]{36}[.](png|jpg|webp)')
    && request.resource.size <= 5 * 1024 * 1024
    && request.resource.contentType.matches('image/(png|jpeg|webp)');
  }
 }
}
