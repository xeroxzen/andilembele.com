rules_version = '2';
// Generated from CMS_ADMIN_EMAILS in .env. Do not edit this file by hand.
service cloud.firestore {
 match /databases/{database}/documents {
  function admin() {
   return request.auth != null && request.auth.token.email_verified == true
    && request.auth.token.firebase.sign_in_provider == 'google.com'
    && request.auth.token.email.lower() in ["thabheloduve@gmail.com","andilembele020@gmail.com"];
  }
  function valid(p, slug) {
   return p.keys().hasAll(['title','slug','excerpt','content','date','coverImage','tags','status'])
    && p.keys().hasOnly(['title','slug','excerpt','content','date','coverImage','tags','status'])
    && p.slug == slug && p.slug is string && p.slug.size() <= 100 && p.slug.matches('[a-z0-9]+(-[a-z0-9]+)*')
    && p.title is string && p.title.size() > 0 && p.title.size() <= 200
    && p.content is string && p.content.size() > 0 && p.content.size() <= 200000
    && p.excerpt is string && p.excerpt.size() <= 1000
    && p.date is string && p.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
    && p.coverImage == '' && p.tags is list && p.tags.size() <= 10
    && (p.tags.size() <= 0 || (p.tags[0] is string && p.tags[0].size() <= 40))
    && (p.tags.size() <= 1 || (p.tags[1] is string && p.tags[1].size() <= 40))
    && (p.tags.size() <= 2 || (p.tags[2] is string && p.tags[2].size() <= 40))
    && (p.tags.size() <= 3 || (p.tags[3] is string && p.tags[3].size() <= 40))
    && (p.tags.size() <= 4 || (p.tags[4] is string && p.tags[4].size() <= 40))
    && (p.tags.size() <= 5 || (p.tags[5] is string && p.tags[5].size() <= 40))
    && (p.tags.size() <= 6 || (p.tags[6] is string && p.tags[6].size() <= 40))
    && (p.tags.size() <= 7 || (p.tags[7] is string && p.tags[7].size() <= 40))
    && (p.tags.size() <= 8 || (p.tags[8] is string && p.tags[8].size() <= 40))
    && (p.tags.size() <= 9 || (p.tags[9] is string && p.tags[9].size() <= 40))
    && p.status in ['draft','published'];
  }
  match /posts/{slug} {
   allow read: if admin() || resource.data.status == 'published';
   allow create, update: if admin() && valid(request.resource.data, slug);
   allow delete: if admin();
  }
 }
}
